{
  "manifest_version": 3,
  "name": "Ctrl+Teach Tars",
  "version": "0.1.1",
  "description": "Browser-wide Tars voice, pointing, and page assistance.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "offscreen", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Talk to Tars"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["grounding-geometry.js", "drawing-lifetime.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "setup.html"
}
