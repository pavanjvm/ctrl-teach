# OpenAI
OPENAI_API_KEY=your-openai-api-key
COURSE_GENERATION_MODEL=gpt-5.4-mini
IMAGE_MODEL=gpt-image-2
COURSE_INTAKE_TIMEOUT_SECONDS=30
COURSE_GENERATION_REQUEST_TIMEOUT_SECONDS=180
TARS_VISUAL_LOCATOR_ENABLED=true
TARS_VISUAL_LOCATOR_MODEL=gpt-5.6-sol
TARS_VISUAL_LOCATOR_TRIAL_MODELS=gpt-5.6-sol
TARS_VISUAL_LOCATOR_SERVICE_TIER=priority
TARS_VISUAL_LOCATOR_REASONING_EFFORT=medium
TARS_VISUAL_LOCATOR_BATCH_REASONING_EFFORT=low
TARS_VISUAL_LOCATOR_TIMEOUT_SECONDS=20
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=ash
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Tavus Role Playing face renderer
# FACE_ID is an optional default; learners can choose an available face in
# Role Playing. PAL_ID is optional; Ctrl+Teach creates an Echo PAL when omitted.
TAVUS_API_KEY=your-tavus-api-key
TAVUS_FACE_ID=
TAVUS_PAL_ID=
TAVUS_MAX_CALL_DURATION_SECONDS=600
TAVUS_PARTICIPANT_LEFT_TIMEOUT_SECONDS=5
TAVUS_PARTICIPANT_ABSENT_TIMEOUT_SECONDS=30

# SQLite
DATABASE_URL=sqlite:///./ctrlteach.db

# Optional users seeded on startup. Add is_admin=true for an admin-studio
# account. Use your own strong password and never ship example credentials.
# APP_USERS=[{"username":"admin","password":"change-me","name":"Course Admin","is_admin":true}]
APP_USERS=[]
# Local demos can set force_password=true in an ignored .env.local file. Never
# use short demo passwords in a shared or production environment.
PASSWORD_PBKDF2_ROUNDS=600000
APP_SESSION_TOKEN_SECRET=replace-with-a-different-long-random-secret
APP_SESSION_TOKEN_TTL_SECONDS=43200
TARS_EXTENSION_TOKEN_SECRET=replace-with-a-long-random-secret
TARS_EXTENSION_TOKEN_TTL_SECONDS=43200

# Local uploads dir
UPLOADS_DIR=./uploads

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:3000"]
