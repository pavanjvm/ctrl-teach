# OpenAI
OPENAI_API_KEY=your-openai-api-key
REALTIME_MODEL=gpt-realtime-2
REALTIME_VOICE=ash
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
IMAGE_MODEL=gpt-image-1

# SQLite
DATABASE_URL=sqlite:///./boardyboo.db

# Basic-auth users seeded on startup
APP_USERS=[{"username":"admin","password":"admin","name":"Admin"}]

# Local uploads dir
UPLOADS_DIR=./uploads

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:3000"]
