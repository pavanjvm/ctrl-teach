# OpenAI
OPENAI_API_KEY=your-openai-api-key
COURSE_GENERATION_MODEL=gpt-5.4-mini
IMAGE_MODEL=gpt-image-2
CLICKY_VISUAL_LOCATOR_ENABLED=true
CLICKY_VISUAL_LOCATOR_MODEL=gpt-5.5
CLICKY_VISUAL_LOCATOR_TRIAL_MODELS=gpt-5.4,gpt-5.5
CLICKY_VISUAL_LOCATOR_REASONING_EFFORT=medium
CLICKY_VISUAL_LOCATOR_TIMEOUT_SECONDS=20
REALTIME_MODEL=gpt-realtime-2
REALTIME_VOICE=ash
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# SQLite
DATABASE_URL=sqlite:///./boardyboo.db

# Basic-auth users seeded on startup
APP_USERS=[{"username":"admin","password":"admin","name":"Admin"}]
CLICKY_EXTENSION_TOKEN_SECRET=replace-with-a-long-random-secret
CLICKY_EXTENSION_TOKEN_TTL_SECONDS=43200

# Local uploads dir
UPLOADS_DIR=./uploads

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:3000"]
